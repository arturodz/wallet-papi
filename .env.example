# --- Required ---

# Neon Postgres connection string (Project → Connection Details → pooled).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Neon Auth base URL (Project → Auth, after provisioning Neon Auth).
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/dbname/auth

# Random string, 32+ chars. Generate with: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=replace-with-32-char-random-string

# --- Optional: document AI (photo → field extraction). Leave blank to disable. ---

# Vercel Blob read/write token (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# Google AI Studio API key for Gemini (document extraction).
GEMINI_API_KEY=
